# ─── API Config ───────────────────────────────────────────
VITE_USE_VERCEL_API=true           # true = Production (Direct) | false = Local (Proxy)
VITE_API_URL=https://your-backend.vercel.app
VITE_BACKEND_TARGET=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Firebase ────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe (clave pública; el precio lo decide el backend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ─── Media ───────────────────────────────────────────────
# Where the site's loop videos are served: the backend's /media route, which
# redirects to signed links of its bucket (upload them with focusly-workflows'
# upload_site_media.py). Empty = VITE_API_URL + /media when VITE_USE_VERCEL_API
# is true, else read them from public/videos (local dev).
VITE_MEDIA_BASE_URL=
